#!/bin/bash
# ===========================================
# Pre-Commit Hook - Security Scanner
# ===========================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}🔍 Running security checks...${NC}"

ERRORS=0

# ===========================================
# 1. BLOCK ALL .env* FILES (CRITICAL)
# ===========================================
ENV_FILES=$(git diff --cached --name-only | grep -E '^\.env' || true)
if [ -n "$ENV_FILES" ]; then
    echo -e "${RED}❌ BLOCKED: .env file(s) detected:${NC}"
    echo "$ENV_FILES"
    echo -e "${RED}   NEVER commit .env files. Use .env.example template only.${NC}"
    ERRORS=$((ERRORS + 1))
fi

# ===========================================
# 2. SCAN CODE FILES FOR SECRETS
# Skip documentation, markdown, configs
# ===========================================
echo -e "${YELLOW}   Scanning code for secrets...${NC}"

# Get staged CODE files only (exclude docs)
CODE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '\.(md|txt|json|yml|yaml|toml|ini|cfg|conf)$' || true)

if [ -n "$CODE_FILES" ]; then
    for file in $CODE_FILES; do
        # Get the staged version of the file
        CONTENT=$(git show "HEAD:$file" 2>/dev/null || echo "")
        STAGED_CONTENT=$(git diff --cached "$file" | grep -E "^\+" | grep -vE '^\+\+\+' || echo "")
        
        # Check each pattern
        echo "$STAGED_CONTENT" | grep -qE "AKIA[0-9A-Z]{16}" && {
            echo -e "${RED}❌ BLOCKED: AWS Access Key in $file${NC}"
            ERRORS=$((ERRORS + 1))
        }
        
        echo "$STAGED_CONTENT" | grep -qE "sk-[0-9a-zA-Z]{40,}" && {
            echo -e "${RED}❌ BLOCKED: OpenAI API Key in $file${NC}"
            ERRORS=$((ERRORS + 1))
        }
        
        echo "$STAGED_CONTENT" | grep -qE "ghp_[0-9a-zA-Z]{36}" && {
            echo -e "${RED}❌ BLOCKED: GitHub Token in $file${NC}"
            ERRORS=$((ERRORS + 1))
        }
        
        echo "$STAGED_CONTENT" | grep -qE "glpat-[0-9a-zA-Z]{20}" && {
            echo -e "${RED}❌ BLOCKED: GitLab Token in $file${NC}"
            ERRORS=$((ERRORS + 1))
        }
        
        echo "$STAGED_CONTENT" | grep -qE "xox[baprs]-[0-9a-zA-Z]{10,48}" && {
            echo -e "${RED}❌ BLOCKED: Slack Token in $file${NC}"
            ERRORS=$((ERRORS + 1))
        }
        
        echo "$STAGED_CONTENT" | grep -qE "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----" && {
            echo -e "${RED}❌ BLOCKED: Private Key in $file${NC}"
            ERRORS=$((ERRORS + 1))
        }
        
        echo "$STAGED_CONTENT" | grep -qE "mongodb\+srv://[^:]+:[^@]+@" && {
            echo -e "${RED}❌ BLOCKED: MongoDB credentials in $file${NC}"
            ERRORS=$((ERRORS + 1))
        }
    done
fi

# ===========================================
# 3. CHECK NPM AUDIT FOR VULNERABILITIES
# ===========================================
if [ -f "frontend/package.json" ] || [ -f "backend/composer.json" ]; then
    echo -e "${YELLOW}   Checking for security vulnerabilities...${NC}"
    
    # Check frontend
    if [ -f "frontend/package.json" ] && [ -d "frontend/node_modules" ]; then
        cd frontend
        AUDIT_RESULT=$(npm audit --quiet 2>&1 || true)
        if echo "$AUDIT_RESULT" | grep -qE "found [0-9]+ (critical|high)"; then
            echo -e "${RED}❌ BLOCKED: Critical/High vulnerabilities in frontend${NC}"
            ERRORS=$((ERRORS + 1))
        fi
        cd - > /dev/null
    fi
    
    # Check backend
    if [ -f "backend/composer.json" ] && [ -d "backend/vendor" ]; then
        cd backend
        if command -v composer &> /dev/null; then
            COMPOSER_AUDIT=$(composer audit --format=json 2>&1 || true)
            if echo "$COMPOSER_AUDIT" | grep -q '"critical":[1-9]'; then
                echo -e "${RED}❌ BLOCKED: Critical vulnerabilities in backend${NC}"
                ERRORS=$((ERRORS + 1))
            elif echo "$COMPOSER_AUDIT" | grep -q '"high":[1-9]'; then
                echo -e "${RED}❌ BLOCKED: High vulnerabilities in backend${NC}"
                ERRORS=$((ERRORS + 1))
            fi
        fi
        cd - > /dev/null
    fi
fi

# ===========================================
# 4. CHECK DEBUG CODE
# ===========================================
DEBUG_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '\.(md|txt|json|yml|yaml)$' || true)
if [ -n "$DEBUG_FILES" ]; then
    DEBUG_CODE=$(git diff --cached -p --diff-filter=ACM | grep -E "^\+" | grep -cE "(var_dump|dd\(|dump\(|console\.log)\(" 2>/dev/null || echo "0")
    if [ "$DEBUG_CODE" -gt 0 ]; then
        echo -e "${YELLOW}⚠️  WARNING: Debug code detected${NC}"
    fi
fi

# ===========================================
# 5. CHECK PHP SYNTAX
# ===========================================
echo -e "${YELLOW}   Checking PHP syntax...${NC}"
PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$' || true)
for file in $PHP_FILES; do
    if ! php -l "$file" > /dev/null 2>&1; then
        echo -e "${RED}❌ PHP syntax error: $file${NC}"
        ERRORS=$((ERRORS + 1))
    fi
done

# ===========================================
# 6. CHECK JS/TS SYNTAX
# ===========================================
echo -e "${YELLOW}   Checking JS/TS syntax...${NC}"
JS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|jsx|tsx)$' || true)
if [ -n "$JS_FILES" ] && command -v node &> /dev/null; then
    for file in $JS_FILES; do
        if ! node --check "$file" 2>/dev/null; then
            if command -v npx &> /dev/null; then
                npx tsc --noEmit --skipLibCheck "$file" 2>/dev/null || true
            fi
        fi
    done
fi

# ===========================================
# RESULT
# ===========================================
if [ $ERRORS -gt 0 ]; then
    echo ""
    echo -e "${RED}❌ PRE-COMMIT BLOCKED: $ERRORS security violation(s)${NC}"
    echo ""
    echo "Security rules:"
    echo "  - NEVER commit .env files"
    echo "  - NEVER commit API keys, tokens in code"
    echo "  - Fix critical/high vulnerabilities"
    echo ""
    echo "To bypass (DANGEROUS): git commit --no-verify -m 'message'"
    exit 1
fi

echo -e "${GREEN}✅ Security checks passed!${NC}"

# Optional linting
if [ -f "backend/vendor/bin/pint" ] && git diff --cached --name-only | grep -qE '\.php$'; then
    echo -e "${YELLOW}   Running Laravel Pint...${NC}"
    git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$' | xargs -I {} ./backend/vendor/bin/pint --test {} 2>/dev/null || true
fi

exit 0
